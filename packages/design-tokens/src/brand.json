{
  "$schema": "./brand.schema.json",
  "name": "Brisa",
  "version": 1,
  "color": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#F0F5F6",
      "surface-raised": "#FFFFFF",
      "border": "#DCE3E6",
      "text": "#14262D",
      "text-muted": "#51626A",
      "primary": "#0B5E67",
      "on-primary": "#FFFFFF",
      "primary-soft": "#D8F4F3",
      "accent": "#19B98F",
      "on-accent": "#032A22",
      "accent-soft": "#DDF5EE",
      "success": "#0E7A62",
      "on-success": "#FFFFFF",
      "success-soft": "#DDF3EC",
      "warning": "#8A5A00",
      "on-warning": "#FFFFFF",
      "warning-soft": "#FBF1DC",
      "danger": "#B3261E",
      "on-danger": "#FFFFFF",
      "danger-soft": "#FBE9E7",
      "focus": "#0B5E67",
      "disabled": "#E6ECEE",
      "on-disabled": "#56656C",
      "chart": "#0E8A94"
    },
    "dark": {
      "background": "#0B1416",
      "surface": "#132024",
      "surface-raised": "#1A2A2F",
      "border": "#2C3E44",
      "text": "#EAF2F3",
      "text-muted": "#A5B6BB",
      "primary": "#6FD0CF",
      "on-primary": "#032628",
      "primary-soft": "#0F3235",
      "accent": "#4FD8AE",
      "on-accent": "#032A22",
      "accent-soft": "#0F3229",
      "success": "#6FD3AE",
      "on-success": "#04241B",
      "success-soft": "#0E2D23",
      "warning": "#F2C46B",
      "on-warning": "#2A1C00",
      "warning-soft": "#2E2209",
      "danger": "#FF8A80",
      "on-danger": "#2B0603",
      "danger-soft": "#3A1210",
      "focus": "#6FD0CF",
      "disabled": "#1E2C30",
      "on-disabled": "#A1AFB3",
      "chart": "#4FC1C9"
    }
  },
  "contrast": [
    ["text", "background"], ["text", "surface"], ["text-muted", "background"], ["text-muted", "surface"],
    ["on-primary", "primary"], ["on-success", "success"], ["on-warning", "warning"], ["on-danger", "danger"],
    ["on-disabled", "disabled"], ["text-muted", "surface-raised"],
    ["primary", "primary-soft"], ["success", "success-soft"], ["warning", "warning-soft"], ["danger", "danger-soft"],
    ["on-accent", "accent"], ["text", "accent-soft"],
    ["text", "primary-soft"], ["success", "background"], ["success", "success-soft"], ["primary", "background"]
  ],
  "typography": {
    "family": { "sans": "Outfit", "mono": "Menlo" },
    "size": { "xs": 12, "sm": 15, "md": 17, "lg": 20, "xl": 28, "2xl": 34 },
    "lineHeight": { "xs": 16, "sm": 20, "md": 22, "lg": 25, "xl": 34, "2xl": 41 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 20, "2xl": 28, "full": 9999 },
  "elevation": {
    "0": { "y": 0, "blur": 0, "opacity": 0 },
    "1": { "y": 1, "blur": 3, "opacity": 0.12 },
    "2": { "y": 4, "blur": 12, "opacity": 0.14 },
    "3": { "y": 8, "blur": 24, "opacity": 0.18 }
  },
  "minTouchTarget": 44,
  "components": {
    "button": {
      "primary": { "bg": "primary", "fg": "on-primary", "radius": "md" },
      "secondary": { "bg": "surface", "fg": "text", "radius": "md", "border": "border" },
      "danger": { "bg": "danger", "fg": "on-danger", "radius": "md" }
    },
    "card": { "default": { "bg": "surface-raised", "fg": "text", "radius": "lg", "elevation": "1" } }
  },
  "assets": {
    "logo": "assets/logo.svg",
    "appIcon": "assets/icon.png",
    "splash": "assets/splash.png"
  },
  "surfaces": {
    "dashboard": {
      "light": {
        "background": "#FFFFFF",
        "surface": "#F3F4F6",
        "surface-raised": "#FFFFFF",
        "border": "#DFE2E8",
        "text": "#171A21",
        "text-muted": "#585F6C",
        "primary": "#2D46C8",
        "on-primary": "#FFFFFF",
        "primary-soft": "#E9EDFC",
        "accent": "#2D46C8",
        "on-accent": "#FFFFFF",
        "accent-soft": "#E9EDFC",
        "success": "#1B7A47",
        "on-success": "#FFFFFF",
        "success-soft": "#E3F3E9",
        "focus": "#2D46C8",
        "disabled": "#ECEEF2",
        "on-disabled": "#5B6270",
        "chart": "#2F6BC4",
        "sidebar": "#15181F",
        "on-sidebar": "#ECEEF3",
        "sidebar-muted": "#9AA1AE",
        "sidebar-active": "#A9B7FF"
      },
      "dark": {
        "background": "#0D0F13",
        "surface": "#111318",
        "surface-raised": "#181B21",
        "border": "#2B2F38",
        "text": "#ECEEF2",
        "text-muted": "#A1A7B3",
        "primary": "#8FA2FF",
        "on-primary": "#0B1442",
        "primary-soft": "#1B2248",
        "accent": "#8FA2FF",
        "on-accent": "#0B1442",
        "accent-soft": "#1B2248",
        "success": "#63CB91",
        "on-success": "#062311",
        "success-soft": "#12281B",
        "focus": "#8FA2FF",
        "disabled": "#1F2229",
        "on-disabled": "#A4AAB5",
        "chart": "#5A92DC",
        "sidebar": "#0A0B0E",
        "on-sidebar": "#ECEEF3",
        "sidebar-muted": "#9AA1AE",
        "sidebar-active": "#A9B7FF"
      },
      "contrast": [["on-sidebar", "sidebar"], ["sidebar-muted", "sidebar"], ["sidebar-active", "sidebar"]]
    }
  }
}
