# Template for production/staging deployment inputs. Copy values into the REAL locations below;
# never commit filled-in secrets. This file only documents variable names — placeholders only.
#
# Top-level vars consumed directly by docker-compose.prod.yml (export them or put them in a
# docker-compose --env-file, e.g. `.env.prod`, which must stay out of Git):
DEPLOY_ENV=staging
REGISTRY=registry.example.com/cleaning-platform
IMAGE_TAG=replace-with-git-sha
SECRETS_DIR=/etc/cleaning-platform

# Everything below is NOT read from this file directly: it documents the contents expected in
# ${SECRETS_DIR}/mysql.env and ${SECRETS_DIR}/api.env (both outside Git, root-owned, mode 0600),
# plus the TLS material expected under ${SECRETS_DIR}/tls/. Create those files on the host, e.g.:
#   install -d -m 700 /etc/cleaning-platform/tls
#   install -m 600 /dev/null /etc/cleaning-platform/mysql.env   # then fill in
#   install -m 600 /dev/null /etc/cleaning-platform/api.env     # then fill in
#
# --- ${SECRETS_DIR}/mysql.env (consumed by the mysql service) ---
# MYSQL_DATABASE=cleaning_platform
# MYSQL_USER=app
# MYSQL_PASSWORD=replace-with-a-strong-random-value
# MYSQL_ROOT_PASSWORD=replace-with-a-strong-random-value
#
# --- ${SECRETS_DIR}/api.env (consumed by the api and migrate services, see apps/api/app/core/config.py) ---
# DATABASE_URL=mysql+asyncmy://app:replace-with-a-strong-random-value@mysql:3306/cleaning_platform
# BUSINESS_TZ=America/Mexico_City
# HOLD_TTL_MINUTES=15
# HOLD_SWEEP_INTERVAL_SECONDS=30
# TRAVEL_BUFFER_MINUTES=60
# WORKDAY_START_HOUR=8
# WORKDAY_END_HOUR=18
# SLOT_STEP_MINUTES=30
# TOKEN_TTL_HOURS=336
# GPS_LOW_ACCURACY_M=100
# SUBSCRIPTION_START_WINDOW_DAYS=28
# PAYMENT_PROVIDER=sandbox
# SANDBOX_WEBHOOK_SECRET=replace-with-a-strong-random-value
#
# Note: auth uses opaque bearer tokens hashed with SHA-256 at rest (ADR 0005) — there is no JWT
# secret in this stack; do not add one.
#
# --- ${SECRETS_DIR}/tls/ (mounted read-only into the nginx container at /etc/nginx/tls) ---
# origin.pem                      Cloudflare Origin CA certificate (Full (strict) mode)
# origin.key                      Private key for origin.pem
# cloudflare-origin-pull-ca.pem   Cloudflare "Authenticated Origin Pulls" CA, used for
#                                 ssl_client_certificate / ssl_verify_client in
#                                 infra/nginx/default.conf
#
# Regenerate infra/nginx/snippets/cloudflare-realip.conf (trusted-proxy CIDR list) periodically
# with scripts/cloudflare-realip.sh — it is generated from https://www.cloudflare.com/ips/ and
# must be reviewed/committed like any other config change, never auto-applied in prod.
